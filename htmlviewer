<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HTML Visual Editor & Previewer</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0f9ff',
                            500: '#0284c7',
                            600: '#0369a1',
                            700: '#075985',
                        }
                    }
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
        .font-mono-code {
            font-family: 'Fira Code', monospace;
        }
        /* Custom scrollbars */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        .dark ::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 4px;
        }
        .dark ::-webkit-scrollbar-thumb:hover {
            background: #475569;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
</head>
<body class="bg-gray-100 dark:bg-gray-950 text-gray-800 dark:text-gray-100 h-screen flex flex-col overflow-hidden transition-colors duration-200">

    <!-- Top Header Navigation -->
    <header class="bg-white dark:bg-gray-900 border-b border-gray-200 dark:border-gray-800 px-4 py-2.5 flex flex-wrap items-center justify-between gap-3 shrink-0 shadow-sm">
        <!-- Logo & Title -->
        <div class="flex items-center space-x-3">
            <div class="bg-brand-600 text-white p-2 rounded-lg font-mono-code font-bold text-sm shadow-md">
                &lt;/&gt;
            </div>
            <div>
                <h1 class="font-bold text-base tracking-tight leading-none text-gray-900 dark:text-white">HTML Lab</h1>
                <p class="text-[11px] text-gray-500 dark:text-gray-400 font-medium mt-0.5">Live Viewer & Code Editor</p>
            </div>
        </div>

        <!-- View Mode Switcher Controls -->
        <div class="flex items-center bg-gray-100 dark:bg-gray-800 p-1 rounded-lg border border-gray-200 dark:border-gray-700 text-xs font-medium">
            <button id="btnViewSplit" class="px-3 py-1.5 rounded-md transition active:scale-95 flex items-center gap-1.5 bg-white dark:bg-gray-700 text-gray-900 dark:text-white shadow-sm" title="Split View">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2"></path></svg>
                <span class="hidden sm:inline">Split View</span>
            </button>
            <button id="btnViewEditor" class="px-3 py-1.5 rounded-md text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition active:scale-95 flex items-center gap-1.5" title="Editor Only">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
                <span class="hidden sm:inline">Editor Only</span>
            </button>
            <button id="btnViewPreview" class="px-3 py-1.5 rounded-md text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition active:scale-95 flex items-center gap-1.5" title="Preview Only">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                <span class="hidden sm:inline">Preview Only</span>
            </button>
        </div>

        <!-- Action Tools & Theme Toggle -->
        <div class="flex items-center space-x-2">
            <!-- Template Select Dropdown -->
            <select id="templateSelect" class="bg-gray-50 dark:bg-gray-800 border border-gray-300 dark:border-gray-700 text-gray-800 dark:text-gray-200 text-xs rounded-lg px-2.5 py-1.5 focus:outline-none focus:ring-2 focus:ring-brand-500 cursor-pointer">
                <option value="" disabled selected>Load Template...</option>
                <option value="basic">Basic HTML Page</option>
                <option value="tailwindCard">Tailwind Card Component</option>
                <option value="formUi">Interactive Form UI</option>
                <option value="svgGraphic">SVG Animated Art</option>
            </select>

            <!-- Theme Switcher -->
            <button id="themeToggleBtn" class="p-2 text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-lg transition" title="Toggle Light/Dark Theme">
                <svg id="themeSunIcon" class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                <svg id="themeMoonIcon" class="w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
            </button>
        </div>
    </header>

    <!-- Sub Toolbar (Import & File Actions) -->
    <div class="bg-gray-50 dark:bg-gray-900/60 border-b border-gray-200 dark:border-gray-800 px-4 py-2 flex flex-wrap items-center justify-between gap-2 shrink-0 text-xs">
        <div class="flex items-center space-x-2">
            <!-- Upload File -->
            <label class="bg-white dark:bg-gray-800 hover:bg-gray-100 dark:hover:bg-gray-750 text-gray-700 dark:text-gray-200 border border-gray-300 dark:border-gray-700 px-3 py-1.5 rounded-md cursor-pointer transition active:scale-95 flex items-center gap-1.5 font-medium shadow-sm">
                <svg class="w-3.5 h-3.5 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
                <span>Upload File</span>
                <input type="file" id="fileInput" accept=".html,.htm,.txt,.xml,.svg" class="hidden">
            </label>

            <!-- Paste Clipboard -->
            <button id="pasteBtn" class="bg-white dark:bg-gray-800 hover:bg-gray-100 dark:hover:bg-gray-750 text-gray-700 dark:text-gray-200 border border-gray-300 dark:border-gray-700 px-3 py-1.5 rounded-md transition active:scale-95 flex items-center gap-1.5 font-medium shadow-sm">
                <svg class="w-3.5 h-3.5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
                <span>Paste</span>
            </button>

            <!-- Clear -->
            <button id="clearBtn" class="bg-white dark:bg-gray-800 hover:bg-rose-50 dark:hover:bg-rose-950/40 text-gray-700 dark:text-gray-300 hover:text-rose-600 dark:hover:text-rose-400 border border-gray-300 dark:border-gray-700 px-3 py-1.5 rounded-md transition active:scale-95 flex items-center gap-1.5 font-medium shadow-sm">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                <span>Clear</span>
            </button>
        </div>

        <div class="flex items-center space-x-2">
            <!-- Copy Code -->
            <button id="copyBtn" class="bg-white dark:bg-gray-800 hover:bg-gray-100 dark:hover:bg-gray-750 text-gray-700 dark:text-gray-200 border border-gray-300 dark:border-gray-700 px-3 py-1.5 rounded-md transition active:scale-95 flex items-center gap-1.5 font-medium shadow-sm">
                <svg class="w-3.5 h-3.5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                <span id="copyBtnText">Copy</span>
            </button>

            <!-- Download -->
            <button id="downloadBtn" class="bg-brand-600 hover:bg-brand-700 text-white px-3.5 py-1.5 rounded-md transition active:scale-95 flex items-center gap-1.5 font-semibold shadow-sm">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                <span>Download</span>
            </button>
        </div>
    </div>

    <!-- Main Workspace Container -->
    <main class="flex-1 flex overflow-hidden relative" id="workspaceContainer">
        
        <!-- Drag & Drop Overlay Indicator -->
        <div id="dropOverlay" class="absolute inset-0 bg-brand-500/10 dark:bg-brand-500/20 backdrop-blur-xs border-4 border-dashed border-brand-500 z-50 flex flex-col items-center justify-center transition-all opacity-0 pointer-events-none">
            <div class="bg-white dark:bg-gray-900 p-6 rounded-2xl shadow-2xl flex flex-col items-center border border-brand-500/30">
                <svg class="w-12 h-12 text-brand-500 animate-bounce mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path></svg>
                <p class="font-bold text-gray-800 dark:text-gray-100 text-base">Drop your HTML file here</p>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Supports .html, .htm, .txt, .xml files</p>
            </div>
        </div>

        <!-- Left Pane: HTML Editor -->
        <section id="editorPane" class="w-1/2 flex flex-col border-r border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 transition-all duration-150">
            <!-- Pane Header -->
            <div class="bg-gray-50 dark:bg-gray-900 border-b border-gray-200 dark:border-gray-800 px-3 py-1.5 flex justify-between items-center text-xs font-semibold text-gray-500 dark:text-gray-400 select-none">
                <span class="flex items-center gap-1.5 font-mono">
                    <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                    SOURCE CODE EDITOR
                </span>
                <span id="charCount" class="font-mono text-[11px] text-gray-400">0 chars</span>
            </div>

            <!-- Text Area + Line Numbers Wrapper -->
            <div class="flex-1 flex relative overflow-hidden font-mono-code text-sm">
                <!-- Line Numbers -->
                <div id="lineNumbers" class="py-3 px-2 text-right bg-gray-50 dark:bg-gray-950 text-gray-400 dark:text-gray-600 select-none border-r border-gray-200 dark:border-gray-850 font-mono text-xs leading-relaxed w-10 shrink-0 overflow-hidden">
                    1
                </div>

                <!-- Textarea Code Input -->
                <textarea id="codeEditor" 
                    spellcheck="false" 
                    placeholder="<!-- Type or paste your HTML code here... -->"
                    class="w-full h-full p-3 bg-transparent text-gray-800 dark:text-gray-100 resize-none focus:outline-none font-mono-code text-xs sm:text-sm leading-relaxed border-none"></textarea>
            </div>
        </section>

        <!-- Right Pane: Live Preview -->
        <section id="previewPane" class="w-1/2 flex flex-col bg-gray-100 dark:bg-gray-950 transition-all duration-150">
            <!-- Pane Header -->
            <div class="bg-gray-50 dark:bg-gray-900 border-b border-gray-200 dark:border-gray-800 px-3 py-1.5 flex justify-between items-center text-xs font-semibold text-gray-500 dark:text-gray-400 select-none">
                <span class="flex items-center gap-1.5 font-mono">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    LIVE PREVIEW (SANDBOX)
                </span>
                <button id="refreshPreviewBtn" class="hover:text-gray-800 dark:hover:text-white transition" title="Reload Preview">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                </button>
            </div>

            <!-- Iframe Container -->
            <div class="flex-1 w-full h-full relative bg-white">
                <iframe id="previewIframe" 
                    sandbox="allow-scripts allow-modals allow-forms allow-same-origin"
                    class="w-full h-full border-none bg-white"></iframe>
            </div>
        </section>
    </main>

    <!-- Notification Toast Container -->
    <div id="toast" class="fixed bottom-4 right-4 bg-gray-900 dark:bg-gray-100 text-white dark:text-gray-900 px-4 py-2.5 rounded-lg shadow-xl text-xs font-medium transform translate-y-10 opacity-0 transition-all duration-200 pointer-events-none flex items-center gap-2 z-50">
        <span id="toastMessage">Action completed!</span>
    </div>

    <!-- Application Logic Script -->
    <script>
        // Sample Templates
        const TEMPLATES = {
            basic: `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <style>
    body { font-family: system-ui, sans-serif; padding: 2rem; background: #fafafa; color: #333; }
    h1 { color: #0284c7; }
    .card { background: white; padding: 1.5rem; border-radius: 8px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); }
  </style>
</head>
<body>
  <div class="card">
    <h1>Hello, World! 👋</h1>
    <p>This is a simple HTML template rendering live inside the sandboxed preview.</p>
    <button onclick="alert('Hello from HTML!')">Click Me</button>
  </div>
</body>
</html>`,

            tailwindCard: `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <script src="https://cdn.tailwindcss.com"><\/script>
</head>
<body class="bg-slate-900 text-white min-h-screen flex items-center justify-center p-6">
  <div class="max-w-sm bg-slate-800 rounded-2xl overflow-hidden shadow-2xl border border-slate-700">
    <img class="w-full h-48 object-cover" src="https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&fit=crop&w=600&q=80" alt="Tech">
    <div class="p-5">
      <span class="text-xs font-bold uppercase tracking-wider text-cyan-400">Tailwind Component</span>
      <h2 class="text-xl font-bold mt-1 text-white">Interactive Preview</h2>
      <p class="text-slate-400 text-sm mt-2">Modify this text in the editor to see real-time UI updates automatically.</p>
      <div class="mt-4 flex gap-2">
        <button class="flex-1 bg-cyan-500 hover:bg-cyan-600 text-slate-950 font-bold py-2 rounded-lg text-sm transition">Explore</button>
        <button class="px-3 border border-slate-600 hover:bg-slate-700 rounded-lg text-sm transition">Share</button>
      </div>
    </div>
  </div>
</body>
</html>`,

            formUi: `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <style>
    body { font-family: system-ui, sans-serif; background: #0f172a; color: #f8fafc; padding: 2rem; display: flex; justify-content: center; }
    form { background: #1e293b; padding: 2rem; border-radius: 12px; width: 100%; max-width: 360px; border: 1px solid #334155; }
    label { display: block; margin-bottom: 0.5rem; font-size: 0.85rem; color: #94a3b8; }
    input { width: 100%; padding: 0.6rem; margin-bottom: 1rem; border-radius: 6px; border: 1px solid #475569; background: #0f172a; color: white; box-sizing: border-box; }
    button { width: 100%; background: #38bdf8; color: #0f172a; font-weight: bold; border: none; padding: 0.7rem; border-radius: 6px; cursor: pointer; }
    button:hover { background: #7dd3fc; }
  </style>
</head>
<body>
  <form onsubmit="event.preventDefault(); alert('Form submitted!');">
    <h2 style="margin-top:0;">User Feedback</h2>
    <label>Name</label>
    <input type="text" placeholder="John Doe" required>
    <label>Email Address</label>
    <input type="email" placeholder="john@example.com" required>
    <button type="submit">Send Feedback</button>
  </form>
</body>
</html>`,

            svgGraphic: `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <style>
    body { background: #050811; display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100vh; margin: 0; color: #38bdf8; font-family: monospace; }
    svg { filter: drop-shadow(0 0 15px rgba(56, 189, 248, 0.4)); animation: spin 10s linear infinite; }
    @keyframes spin { 100% { transform: rotate(360deg); } }
  </style>
</head>
<body>
  <svg width="150" height="150" viewBox="0 0 100 100">
    <circle cx="50" cy="50" r="40" stroke="#38bdf8" stroke-width="4" fill="none" stroke-dasharray="10 5" />
    <polygon points="50,20 75,70 25,70" fill="#818cf8" opacity="0.8" />
    <circle cx="50" cy="50" r="10" fill="#f43f5e" />
  </svg>
  <p>SVG Vector Graphic Animation</p>
</body>
</html>`
        };

        // DOM Element References
        const codeEditor = document.getElementById('codeEditor');
        const previewIframe = document.getElementById('previewIframe');
        const lineNumbers = document.getElementById('lineNumbers');
        const charCount = document.getElementById('charCount');
        const editorPane = document.getElementById('editorPane');
        const previewPane = document.getElementById('previewPane');
        const templateSelect = document.getElementById('templateSelect');

        // View Buttons
        const btnViewSplit = document.getElementById('btnViewSplit');
        const btnViewEditor = document.getElementById('btnViewEditor');
        const btnViewPreview = document.getElementById('btnViewPreview');

        // Action Buttons
        const fileInput = document.getElementById('fileInput');
        const pasteBtn = document.getElementById('pasteBtn');
        const clearBtn = document.getElementById('clearBtn');
        const copyBtn = document.getElementById('copyBtn');
        const copyBtnText = document.getElementById('copyBtnText');
        const downloadBtn = document.getElementById('downloadBtn');
        const themeToggleBtn = document.getElementById('themeToggleBtn');
        const refreshPreviewBtn = document.getElementById('refreshPreviewBtn');
        const dropOverlay = document.getElementById('dropOverlay');
        const workspaceContainer = document.getElementById('workspaceContainer');

        // Toast Helper
        function showToast(message) {
            const toast = document.getElementById('toast');
            const toastMessage = document.getElementById('toastMessage');
            toastMessage.textContent = message;
            toast.classList.remove('translate-y-10', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');

            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('translate-y-10', 'opacity-0');
            }, 2500);
        }

        // Live Preview Renderer
        function updatePreview() {
            const content = codeEditor.value;
            const doc = previewIframe.contentDocument || previewIframe.contentWindow.document;
            doc.open();
            doc.write(content);
            doc.close();
            
            // Update Stats
            charCount.textContent = `${content.length.toLocaleString()} chars`;
            updateLineNumbers();
        }

        // Line Numbers Synchronizer
        function updateLineNumbers() {
            const lines = codeEditor.value.split('\n').length;
            let lineNumsHTML = '';
            for (let i = 1; i <= lines; i++) {
                lineNumsHTML += i + '<br>';
            }
            lineNumbers.innerHTML = lineNumsHTML;
        }

        // Scroll Line Numbers in Sync with Editor
        codeEditor.addEventListener('scroll', () => {
            lineNumbers.scrollTop = codeEditor.scrollTop;
        });

        // Input Listener
        codeEditor.addEventListener('input', updatePreview);

        // Tab Key Support Inside Editor
        codeEditor.addEventListener('keydown', (e) => {
            if (e.key === 'Tab') {
                e.preventDefault();
                const start = codeEditor.selectionStart;
                const end = codeEditor.selectionEnd;

                codeEditor.value = codeEditor.value.substring(0, start) + '  ' + codeEditor.value.substring(end);
                codeEditor.selectionStart = codeEditor.selectionEnd = start + 2;
                updatePreview();
            }
        });

        // View Mode Switcher
        function setViewMode(mode) {
            btnViewSplit.className = "px-3 py-1.5 rounded-md text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition active:scale-95 flex items-center gap-1.5";
            btnViewEditor.className = "px-3 py-1.5 rounded-md text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition active:scale-95 flex items-center gap-1.5";
            btnViewPreview.className = "px-3 py-1.5 rounded-md text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition active:scale-95 flex items-center gap-1.5";

            const activeClass = "px-3 py-1.5 rounded-md transition active:scale-95 flex items-center gap-1.5 bg-white dark:bg-gray-700 text-gray-900 dark:text-white shadow-sm font-semibold";

            if (mode === 'split') {
                btnViewSplit.className = activeClass;
                editorPane.classList.remove('hidden', 'w-full');
                editorPane.classList.add('w-1/2');
                previewPane.classList.remove('hidden', 'w-full');
                previewPane.classList.add('w-1/2');
            } else if (mode === 'editor') {
                btnViewEditor.className = activeClass;
                editorPane.classList.remove('hidden', 'w-1/2');
                editorPane.classList.add('w-full');
                previewPane.classList.add('hidden');
            } else if (mode === 'preview') {
                btnViewPreview.className = activeClass;
                previewPane.classList.remove('hidden', 'w-1/2');
                previewPane.classList.add('w-full');
                editorPane.classList.add('hidden');
            }
        }

        btnViewSplit.onclick = () => setViewMode('split');
        btnViewEditor.onclick = () => setViewMode('editor');
        btnViewPreview.onclick = () => setViewMode('preview');

        // Load Templates
        templateSelect.onchange = (e) => {
            const key = e.target.value;
            if (TEMPLATES[key]) {
                codeEditor.value = TEMPLATES[key];
                updatePreview();
                showToast('Template loaded successfully');
            }
        };

        // Upload File Handler
        fileInput.onchange = (e) => {
            const file = e.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = (event) => {
                codeEditor.value = event.target.result;
                updatePreview();
                showToast(`Loaded "${file.name}"`);
            };
            reader.readAsText(file);
            fileInput.value = '';
        };

        // Paste from Clipboard
        pasteBtn.onclick = async () => {
            try {
                const text = await navigator.clipboard.readText();
                if (text) {
                    codeEditor.value = text;
                    updatePreview();
                    showToast('Pasted content from clipboard');
                } else {
                    showToast('Clipboard is empty');
                }
            } catch (err) {
                showToast('Clipboard access denied. Please use Ctrl+V / Cmd+V');
            }
        };

        // Clear Editor
        clearBtn.onclick = () => {
            codeEditor.value = '';
            updatePreview();
            showToast('Editor cleared');
        };

        // Copy Code
        copyBtn.onclick = () => {
            if (!codeEditor.value.trim()) {
                showToast('Nothing to copy!');
                return;
            }
            codeEditor.select();
            document.execCommand('copy');
            
            copyBtnText.textContent = 'Copied!';
            showToast('Copied code to clipboard');
            setTimeout(() => {
                copyBtnText.textContent = 'Copy';
            }, 2000);
        };

        // Download HTML File
        downloadBtn.onclick = () => {
            const code = codeEditor.value;
            if (!code.trim()) {
                showToast('Editor is empty!');
                return;
            }
            const blob = new Blob([code], { type: 'text/html' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'index.html';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
            showToast('Downloaded index.html');
        };

        // Refresh Preview Button
        refreshPreviewBtn.onclick = () => {
            updatePreview();
            showToast('Preview refreshed');
        };

        // Light/Dark Theme Switcher
        themeToggleBtn.onclick = () => {
            document.documentElement.classList.toggle('dark');
            const isDark = document.documentElement.classList.contains('dark');
            showToast(`Switched to ${isDark ? 'Dark' : 'Light'} theme`);
        };

        // Drag and Drop File Support
        ['dragenter', 'dragover'].forEach(eventName => {
            workspaceContainer.addEventListener(eventName, (e) => {
                e.preventDefault();
                e.stopPropagation();
                dropOverlay.classList.remove('opacity-0', 'pointer-events-none');
                dropOverlay.classList.add('opacity-100');
            }, false);
        });

        ['dragleave', 'drop'].forEach(eventName => {
            workspaceContainer.addEventListener(eventName, (e) => {
                e.preventDefault();
                e.stopPropagation();
                dropOverlay.classList.remove('opacity-100');
                dropOverlay.classList.add('opacity-0', 'pointer-events-none');
            }, false);
        });

        workspaceContainer.addEventListener('drop', (e) => {
            const files = e.dataTransfer.files;
            if (files.length > 0) {
                const file = files[0];
                const reader = new FileReader();
                reader.onload = (event) => {
                    codeEditor.value = event.target.result;
                    updatePreview();
                    showToast(`Loaded file: ${file.name}`);
                };
                reader.readAsText(file);
            }
        });

        // Initialize default template on startup
        window.onload = () => {
            codeEditor.value = TEMPLATES.tailwindCard;
            updatePreview();
        };
    </script>
</body>
</html>
